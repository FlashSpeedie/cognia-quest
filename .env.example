# ── AI Quest environment ────────────────────────────────────────────────
# Copy to .env.local for development. NEVER commit real secrets.

# Public URL of the app (used for metadata / absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign local dev session cookies (any long random string).
# Required whenever Supabase is NOT configured.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# ── Supabase (production backend) ───────────────────────────────────────
# When these are set, the app uses Supabase Postgres (see supabase/migrations).
# When absent, the app runs on a self-contained local dev datastore
# (data/dev-db.json) so the product works fully offline.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Datastore ───────────────────────────────────────────────────────────
# Override the local dev database file location (used in tests).
LOCAL_DB_PATH=data/dev-db.json

# ── Testing ─────────────────────────────────────────────────────────────
# TEST-ONLY: disables API rate limiting. Set automatically by the Playwright
# webServer. Never set this in a real deployment.
# AQ_DISABLE_RATE_LIMIT=0
