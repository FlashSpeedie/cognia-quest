# ── AI Quest environment ─────────────────────────────────────────────────
# Copy to .env.local for local development. NEVER commit real secrets.
# Names only — no production values belong in this file.

# ── Supabase (production backend) ────────────────────────────────────────
# When all three are set, the app uses Supabase Auth + Supabase Postgres
# (apply supabase/migrations/ in order). When absent, it falls back to a
# self-contained local datastore + local password auth (development/test
# only — never use that fallback in a real deployment).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy alias, still accepted: SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (optional live AI features) ───────────────────────────────────
# Server-only. When set, enables the AI tutor / prompt coach endpoints.
# The whole app works without it — those panels show an honest
# "not enabled on this server" state instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── App ──────────────────────────────────────────────────────────────────
# Canonical public URL of the deployment. Production value:
# https://cognia-quest.vercel.app
# NEXT_PUBLIC_SITE_URL is the preferred name; NEXT_PUBLIC_APP_URL is a legacy
# alias. On Vercel, set one of them (Production environment) in project
# settings - it drives SEO canonicals, sitemap, robots.txt, structured data,
# and Supabase email links (signup confirmation + password reset).
# Fallback chain when unset: VERCEL_PROJECT_PRODUCTION_URL, then localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Development / test only (never set these in a real deployment) ───────
# Session-cookie HMAC key for the LOCAL auth fallback.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Local dev datastore file.
LOCAL_DB_PATH=data/dev-db.json
# TEST-ONLY: disables API rate limiting; set automatically by the
# Playwright webServer. Ignored (with a loud startup warning) when Supabase
# is configured, so it can never weaken a real deployment.
# AQ_DISABLE_RATE_LIMIT=1
